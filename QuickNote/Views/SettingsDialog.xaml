<Window x:Class="QuickNote.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="470" Height="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border CornerRadius="16" Background="{StaticResource BgCardBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            Padding="22,18">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="设置" FontSize="17" FontWeight="SemiBold" />

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="取消" Width="76" Height="32"
                        Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click" />
                <Button Content="保存位置" Width="92" Height="32" Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Click="Ok_Click" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,4,0">
                <StackPanel>
                    <TextBlock Text="数据位置" FontSize="12" FontWeight="Medium"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,14,0,8" />

                    <RadioButton x:Name="ScopeUser" GroupName="DataScope" FontSize="13"
                                 Content="仅当前 Windows 用户"
                                 Checked="Scope_Checked" />
                    <TextBlock x:Name="UserPathText" FontSize="11"
                               Foreground="{StaticResource TextHintBrush}"
                               Margin="22,3,0,10"
                               TextTrimming="CharacterEllipsis" />

                    <RadioButton x:Name="ScopeAll" GroupName="DataScope" FontSize="13"
                                 Content="本机所有 Windows 用户共享"
                                 Checked="Scope_Checked" />
                    <TextBlock FontSize="11" Foreground="{StaticResource TextHintBrush}"
                               TextWrapping="Wrap" Margin="22,3,0,10"
                               Text="同一台电脑上的其他账号打开 QuickNote 时看到同一份话术。第一次切换会把现有话术和图片复制过去。" />

                    <RadioButton x:Name="ScopeCustom" GroupName="DataScope" FontSize="13"
                                 Content="自定义文件夹（共享盘 / 网盘）"
                                 Checked="Scope_Checked" />
                    <DockPanel Margin="22,6,0,0">
                        <Button DockPanel.Dock="Right" Content="浏览…" Margin="6,0,0,0"
                                Style="{StaticResource TintButton}"
                                FontSize="12" Padding="8,3"
                                Click="Browse_Click" />
                        <TextBox x:Name="CustomPathBox" Style="{StaticResource IOSTextBox}"
                                 MinHeight="34" FontSize="12"
                                 TextChanged="CustomPathBox_TextChanged" />
                    </DockPanel>

                    <TextBlock x:Name="HintText" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource TextHintBrush}"
                               Margin="0,14,0,0" />

                    <!-- ════ 运行信息 ════════════════════════════════════════ -->
                    <DockPanel Margin="0,20,0,8">
                        <Button DockPanel.Dock="Right" Content="复制运行信息"
                                Style="{StaticResource TintButton}"
                                FontSize="12" Padding="8,3" Margin="6,0,0,0"
                                Click="CopyRuntimeInfo_Click" />
                        <Button DockPanel.Dock="Right" Content="打开日志文件夹"
                                Style="{StaticResource TintButton}"
                                FontSize="12" Padding="8,3"
                                Click="OpenLogFolder_Click" />
                        <TextBlock Text="运行信息" FontSize="12" FontWeight="Medium"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <Border Background="{StaticResource BgInputBrush}" CornerRadius="10"
                            Padding="12,10">
                        <StackPanel>
                            <!-- Read-only TextBox, not TextBlock: WPF TextBlock has
                                 no selection, so paths and logs could not be copied
                                 out of a label. -->
                            <TextBox x:Name="PathsText" IsReadOnly="True"
                                     FontSize="11.5" FontFamily="Consolas, Microsoft YaHei UI"
                                     Foreground="{StaticResource TextSecondaryBrush}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     TextWrapping="Wrap" />

                            <TextBlock Text="本次启动（last-run.txt）" FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,12,0,4" />
                            <TextBox x:Name="RunInfoText" IsReadOnly="True"
                                     FontSize="11" FontFamily="Consolas, Microsoft YaHei UI"
                                     Foreground="{StaticResource TextHintBrush}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     TextWrapping="Wrap" />

                            <TextBlock x:Name="ErrorHeading" Text="错误记录（error.log）"
                                       FontSize="11" FontWeight="Medium"
                                       Foreground="{StaticResource DangerBrush}"
                                       Margin="0,12,0,4" />
                            <TextBox x:Name="ErrorText" IsReadOnly="True"
                                     FontSize="11" FontFamily="Consolas, Microsoft YaHei UI"
                                     Foreground="{StaticResource TextHintBrush}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource TextHintBrush}"
                               Margin="2,8,0,0"
                               Text="日志只记录在本机，不会上传。出现「QuickNote 无法继续」弹窗时，点上面的「复制运行信息」，把内容直接粘贴发过来即可定位问题。" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
