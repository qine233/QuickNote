<Window x:Class="QuickNote.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="470" Height="492"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border CornerRadius="16" Background="{StaticResource BgCardBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            Padding="22,18">
        <StackPanel>
            <TextBlock Text="设置" FontSize="17" FontWeight="SemiBold" />

            <TextBlock Text="数据位置" FontSize="12" FontWeight="Medium"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,18,0,8" />

            <RadioButton x:Name="ScopeUser" GroupName="DataScope" FontSize="13"
                         Content="仅当前 Windows 用户"
                         Checked="Scope_Checked" />
            <TextBlock x:Name="UserPathText" FontSize="11"
                       Foreground="{StaticResource TextHintBrush}"
                       Margin="22,3,0,10"
                       TextTrimming="CharacterEllipsis" />

            <RadioButton x:Name="ScopeAll" GroupName="DataScope" FontSize="13"
                         Content="本机所有 Windows 用户共享"
                         Checked="Scope_Checked" />
            <TextBlock FontSize="11" Foreground="{StaticResource TextHintBrush}"
                       TextWrapping="Wrap" Margin="22,3,0,10"
                       Text="同一台电脑上的其他账号打开 QuickNote 时看到同一份话术。第一次切换会把现有话术和图片复制过去。" />

            <RadioButton x:Name="ScopeCustom" GroupName="DataScope" FontSize="13"
                         Content="自定义文件夹（共享盘 / 网盘）"
                         Checked="Scope_Checked" />
            <DockPanel Margin="22,6,0,0">
                <Button DockPanel.Dock="Right" Content="浏览…" Margin="6,0,0,0"
                        Style="{StaticResource TintButton}"
                        FontSize="12" Padding="8,3"
                        Click="Browse_Click" />
                <TextBox x:Name="CustomPathBox" Style="{StaticResource IOSTextBox}"
                         Height="30" FontSize="12"
                         TextChanged="CustomPathBox_TextChanged" />
            </DockPanel>

            <TextBlock x:Name="HintText" FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource TextHintBrush}"
                       Margin="0,14,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Width="76" Height="32"
                        Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click" />
                <Button Content="保存" Width="76" Height="32" Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
