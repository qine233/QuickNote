<Window x:Class="QuickNote.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入"
        Width="360" Height="188"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border CornerRadius="16" Background="{StaticResource BgCardBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            Padding="20,18">
        <StackPanel>
            <TextBlock x:Name="PromptText" Text="请输入：" FontSize="15"
                       FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBox x:Name="InputBox" Style="{StaticResource IOSTextBox}"
                     Height="36" FontSize="13"
                     KeyDown="InputBox_KeyDown" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Width="72" Height="32"
                        Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click" />
                <Button Content="确定" Width="72" Height="32" Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
