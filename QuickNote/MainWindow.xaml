<Window x:Class="QuickNote.MainWindow"
        x:Name="mainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:QuickNote.Converters"
        xmlns:models="clr-namespace:QuickNote.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="QuickNote"
        Width="520" Height="820"
        MinWidth="420" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ResizeMode="CanResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="16"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
        <conv:CountToVisibilityConverter x:Key="CountToVis" />

        <!-- iOS segmented control item -->
        <Style x:Key="SegmentTab" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" CornerRadius="7" Padding="18,4"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS filter chip -->
        <Style x:Key="ChipItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bg" CornerRadius="16"
                                Margin="0,0,6,6" Padding="12,6"
                                Background="{StaticResource BgInputBrush}">
                            <ContentPresenter x:Name="content"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#DEDEE3" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="content" Property="TextElement.Foreground"
                                        Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Window shell -->
    <Border CornerRadius="16" Background="{StaticResource BgMainBrush}"
            BorderBrush="#22000000" BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />   <!-- nav bar -->
                <RowDefinition Height="Auto" /> <!-- toolbar: segmented + actions -->
                <RowDefinition Height="Auto" /> <!-- search -->
                <RowDefinition Height="*" />    <!-- content -->
                <RowDefinition Height="Auto" /> <!-- status bar -->
            </Grid.RowDefinitions>

            <!-- ════════════════════════════════════════════════════════════
                 NAV BAR
                 ════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="6"
                                Background="{StaticResource PrimaryBrush}">
                            <TextBlock Text="Q" FontSize="11" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="QuickNote" FontSize="13.5" FontWeight="SemiBold"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="&#xE921;" Style="{StaticResource WindowButton}"
                                Click="MinimizeButton_Click" ToolTip="最小化" />
                        <Button Content="&#xE922;" Style="{StaticResource WindowButton}"
                                Click="MaximizeButton_Click" ToolTip="最大化" />
                        <Button Content="&#xE8BB;" Style="{StaticResource WindowCloseButton}"
                                Click="CloseButton_Click" ToolTip="隐藏到系统托盘" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 TOOLBAR: segmented control + actions (single row)
                 ════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="1" Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,0,1" Padding="12,8">
                <Grid>
                    <!-- Segmented control -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{StaticResource BgInputBrush}"
                            CornerRadius="9" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="话术" GroupName="MainTabs"
                                         Style="{StaticResource SegmentTab}"
                                         IsChecked="True"
                                         Checked="ScriptsTab_Checked" />
                            <RadioButton Content="文件" GroupName="MainTabs"
                                         Style="{StaticResource SegmentTab}"
                                         Checked="FilesTab_Checked" />
                        </StackPanel>
                    </Border>

                    <!-- Scripts actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsScriptsTab, Converter={StaticResource BoolToVis}}">
                        <Button Content="&#xE77F;" Style="{StaticResource IconButton}"
                                Command="{Binding OpenClipboardCommand}"
                                ToolTip="剪切板历史（最近 20 条）" />
                        <Button Content="&#xE896;" Style="{StaticResource IconButton}"
                                Command="{Binding ImportCommand}"
                                Margin="2,0,0,0" ToolTip="导入话术" />
                        <Button Content="&#xE898;" Style="{StaticResource IconButton}"
                                Command="{Binding ExportCommand}"
                                Margin="2,0,0,0" ToolTip="导出话术" />
                        <Button Command="{Binding AddScriptCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Height="30" Padding="12,0" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}"
                                           FontSize="11" Foreground="White"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="新建" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="White" Margin="4,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Files actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsFilesTab, Converter={StaticResource BoolToVis}}">
                        <Button Content="&#xE72C;" Style="{StaticResource IconButton}"
                                Command="{Binding RefreshFolderCommand}"
                                ToolTip="重新索引当前文件夹" />
                        <Button Command="{Binding AddFolderCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Height="30" Padding="12,0" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}"
                                           FontSize="11" Foreground="White"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="文件夹" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="White" Margin="4,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 SEARCH
                 ════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Background="{StaticResource BgInputBrush}"
                    CornerRadius="10" Height="34" Margin="16,8,16,8">
                <Grid>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}"
                               FontSize="12.5" Foreground="{StaticResource TextHintBrush}"
                               VerticalAlignment="Center" Margin="11,0,0,0" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0"
                             FontSize="13" Padding="32,0,10,0"
                             VerticalContentAlignment="Center"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             CaretBrush="{StaticResource PrimaryBrush}" />
                    <TextBlock Text="{Binding SearchHint}" FontSize="13"
                               Foreground="{StaticResource TextHintBrush}"
                               VerticalAlignment="Center" Margin="32,0,10,0"
                               IsHitTestVisible="False"
                               Visibility="{Binding SearchText, Converter={StaticResource StringToVis}, ConverterParameter=Invert}" />
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 SCRIPTS TAB
                 ════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="3"
                  Visibility="{Binding IsScriptsTab, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="62" MinHeight="44" MaxHeight="360" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Category chips (height can be dragged to reveal more) -->
                <DockPanel Grid.Row="0">
                    <Grid DockPanel.Dock="Top" Margin="16,8,12,2">
                        <TextBlock Text="分类" FontSize="12" FontWeight="Medium"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Content="＋ 新建分类" HorizontalAlignment="Right"
                                Style="{StaticResource TintButton}"
                                FontSize="12" Padding="8,3"
                                Command="{Binding AddCategoryCommand}" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="16,0,12,4">
                        <ListBox ItemsSource="{Binding Categories}"
                                 SelectedItem="{Binding SelectedCategory}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem"
                                       BasedOn="{StaticResource ChipItemStyle}" />
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>

                <GridSplitter Grid.Row="1" Height="6"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="Transparent" Cursor="SizeNS"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Grid Background="Transparent">
                                <Border Height="2" Background="{StaticResource DividerBrush}"
                                        VerticalAlignment="Center" Margin="16,0" />
                            </Grid>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <Grid Grid.Row="2" Margin="12,4,12,6">
                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding TotalScriptCount, Converter={StaticResource CountToVis}, ConverterParameter=Invert}">
                        <Border Width="76" Height="76" CornerRadius="38"
                                Background="{StaticResource PrimaryLightBrush}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="&#xE77F;" FontFamily="{StaticResource IconFont}"
                                       FontSize="28" Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="暂无话术" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <TextBlock Text="点击「新建」添加，或导入已有数据"
                                   FontSize="12.5" Foreground="{StaticResource TextHintBrush}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- Script list card (single-line rows) -->
                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="12"
                            Visibility="{Binding TotalScriptCount, Converter={StaticResource CountToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      ScrollChanged="ScriptList_ScrollChanged">
                            <ItemsControl ItemsSource="{Binding Scripts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Script}">
                                        <Border Cursor="Hand"
                                                BorderBrush="{StaticResource DividerBrush}"
                                                BorderThickness="0,0,0,1"
                                                MouseLeftButtonUp="ScriptCard_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource BgHoverBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid Margin="14,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Background="{StaticResource PrimaryLightBrush}"
                                                        CornerRadius="6" Padding="6,1"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding HasImages, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="有图" FontSize="10"
                                                               Foreground="{StaticResource PrimaryBrush}" />
                                                </Border>

                                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                           FontSize="13" FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="160"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding Title, Converter={StaticResource StringToVis}}" />

                                                <TextBlock Grid.Column="2" Text="{Binding Preview}"
                                                           Visibility="{Binding Preview, Converter={StaticResource StringToVis}}"
                                                           FontSize="13"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="4,0,0,0"
                                                           VerticalAlignment="Center" />

                                                <Button Grid.Column="3"
                                                        Content="&#xE712;" Width="26" Height="26"
                                                        FontSize="13" Padding="0"
                                                        Margin="8,0,0,0"
                                                        Style="{StaticResource IconButton}"
                                                        ToolTip="更多操作"
                                                        Click="ScriptMenuButton_Click" />
                                            </Grid>

                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="复制内容"
                                                              Command="{Binding DataContext.CopyScriptCommand, Source={x:Reference mainWindow}}"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="编辑"
                                                              Command="{Binding DataContext.EditScriptCommand, Source={x:Reference mainWindow}}"
                                                              CommandParameter="{Binding}" />
                                                    <Separator />
                                                    <MenuItem Header="删除"
                                                              Command="{Binding DataContext.DeleteScriptCommand, Source={x:Reference mainWindow}}"
                                                              CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- ════════════════════════════════════════════════════════════
                 FILES TAB
                 ════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="3"
                  Visibility="{Binding IsFilesTab, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="62" MinHeight="44" MaxHeight="360" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Folder chips (height can be dragged to reveal more) -->
                <DockPanel Grid.Row="0">
                    <Grid DockPanel.Dock="Top" Margin="16,8,12,2">
                        <TextBlock Text="文件夹分类" FontSize="12" FontWeight="Medium"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="右键可管理文件夹" FontSize="11"
                                   Foreground="{StaticResource TextHintBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="16,0,12,4">
                        <ListBox ItemsSource="{Binding FolderCategories}"
                                 SelectedItem="{Binding SelectedFolderCategory}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem"
                                       BasedOn="{StaticResource ChipItemStyle}" />
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:FolderCategory}">
                                    <TextBlock Text="{Binding Name}" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Path}">
                                        <TextBlock.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="重新索引"
                                                          Command="{Binding DataContext.RefreshFolderCommand, Source={x:Reference mainWindow}}" />
                                                <MenuItem Header="移除文件夹"
                                                          Command="{Binding DataContext.RemoveFolderCommand, Source={x:Reference mainWindow}}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </TextBlock.ContextMenu>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>

                <GridSplitter Grid.Row="1" Height="6"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="Transparent" Cursor="SizeNS"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Grid Background="Transparent">
                                <Border Height="2" Background="{StaticResource DividerBrush}"
                                        VerticalAlignment="Center" Margin="16,0" />
                            </Grid>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <Grid Grid.Row="2" Margin="12,4,12,6">
                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IndexedFiles.Count, Converter={StaticResource CountToVis}, ConverterParameter=Invert}">
                        <Border Width="76" Height="76" CornerRadius="38"
                                Background="{StaticResource PrimaryLightBrush}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}"
                                       FontSize="28" Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="暂无文件" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <TextBlock Text="点击「文件夹」添加本地目录，文件会显示在这里"
                                   FontSize="12.5" Foreground="{StaticResource TextHintBrush}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- File list card (virtualized) -->
                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="12"
                            Visibility="{Binding IndexedFiles.Count, Converter={StaticResource CountToVis}}">
                        <ItemsControl ItemsSource="{Binding IndexedFiles}"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:IndexedFile}">
                                    <Border Cursor="Hand"
                                            ToolTip="点击复制文件，可直接粘贴到聊天窗口发送"
                                            BorderBrush="{StaticResource DividerBrush}"
                                            BorderThickness="0,0,0,1"
                                            MouseLeftButtonUp="FileRow_Click">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background"
                                                                Value="{StaticResource BgHoverBrush}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid Margin="14,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="34" Height="34"
                                                    CornerRadius="9" VerticalAlignment="Center"
                                                    Background="{Binding IconBackground}">
                                                <TextBlock Text="{Binding Glyph}"
                                                           FontFamily="{StaticResource IconFont}"
                                                           FontSize="16"
                                                           Foreground="{Binding IconForeground}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                        Margin="10,0,8,0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="14"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DetailText}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource TextHintBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="复制"
                                                       FontSize="12.5" FontWeight="Medium"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
            </Grid>

            <!-- ════════════════════════════════════════════════════════════
                 STATUS BAR
                 ════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="4" Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,1,0,0" Padding="18,7"
                    CornerRadius="0,0,16,16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding FooterText}"
                               FontSize="11" Foreground="{StaticResource TextHintBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding FooterHint}"
                               FontSize="11" Foreground="{StaticResource TextHintBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                </DockPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 EDIT OVERLAY (iOS modal sheet)
                 ════════════════════════════════════════════════════════════ -->
            <Grid Grid.RowSpan="5" Panel.ZIndex="10"
                  Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                <Border Background="#66000000" CornerRadius="16"
                        MouseLeftButtonDown="EditOverlay_BackgroundClick" />

                <Border Background="{StaticResource BgCardBrush}"
                        CornerRadius="20" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        MaxWidth="500" MaxHeight="640" Margin="20"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="20,16,16,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Content="取消" Style="{StaticResource TintButton}"
                                        Command="{Binding CancelEditCommand}" />
                                <Button Content="保存" Style="{StaticResource PrimaryButton}"
                                        Height="32" Padding="16,0" Margin="6,0,0,0"
                                        Click="SaveEditButton_Click" />
                            </StackPanel>
                            <TextBlock Text="编辑话术" FontSize="17" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20,0,16,20">
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="标题" FontSize="12" FontWeight="Medium"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="2,10,0,6" />
                                <TextBox Style="{StaticResource IOSTextBox}"
                                         Height="36" Margin="0,0,0,14"
                                         Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="分类" FontSize="12" FontWeight="Medium"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="2,0,0,6" />
                                <ComboBox Style="{StaticResource IOSComboBox}"
                                          ItemsSource="{Binding Categories}"
                                          Text="{Binding EditCategory, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Height="36" Margin="0,0,0,14" />

                                <DockPanel Margin="2,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="＋ 插入图片"
                                            Style="{StaticResource TintButton}"
                                            FontSize="12" Padding="8,4"
                                            Click="InsertImageButton_Click" />
                                    <TextBlock Text="话术内容" FontSize="12" FontWeight="Medium"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </DockPanel>

                                <Border Background="{StaticResource BgMainBrush}"
                                        CornerRadius="12" Padding="8">
                                    <RichTextBox x:Name="ContentEditor"
                                                 BorderThickness="0" Background="Transparent"
                                                 FontFamily="{StaticResource AppFont}" FontSize="13"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 CaretBrush="{StaticResource PrimaryBrush}"
                                                 IsDocumentEnabled="True"
                                                 MinHeight="150" MaxHeight="240"
                                                 VerticalScrollBarVisibility="Auto"
                                                 AcceptsTab="False"
                                                 SpellCheck.IsEnabled="False"
                                                 PreviewKeyDown="ContentEditor_PreviewKeyDown" />
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="2,10,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="选中图片后：" FontSize="11"
                                               Foreground="{StaticResource TextHintBrush}"
                                               VerticalAlignment="Center" />
                                    <Button x:Name="ImageUpButton" Content="↑ 前移" IsEnabled="False"
                                            Style="{StaticResource TintButton}"
                                            FontSize="11.5" Padding="8,4" Margin="4,0,0,0"
                                            Click="MoveImageUp_Click" />
                                    <Button x:Name="ImageDownButton" Content="↓ 后移" IsEnabled="False"
                                            Style="{StaticResource TintButton}"
                                            FontSize="11.5" Padding="8,4" Margin="2,0,0,0"
                                            Click="MoveImageDown_Click" />
                                    <Button x:Name="ImageDeleteButton" Content="删除图片" IsEnabled="False"
                                            Style="{StaticResource TintButton}"
                                            FontSize="11.5" Padding="8,4" Margin="2,0,0,0"
                                            Foreground="{StaticResource DangerBrush}"
                                            Click="DeleteImage_Click" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ════════════════════════════════════════════════════════════
                 CLIPBOARD HISTORY OVERLAY
                 ════════════════════════════════════════════════════════════ -->
            <Grid Grid.RowSpan="5" Panel.ZIndex="15"
                  Visibility="{Binding IsClipboardOpen, Converter={StaticResource BoolToVis}}">
                <Border Background="#66000000" CornerRadius="16"
                        MouseLeftButtonDown="ClipboardOverlay_BackgroundClick" />

                <Border Background="{StaticResource BgCardBrush}"
                        CornerRadius="20" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        MaxWidth="480" MaxHeight="600" Margin="20"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <DockPanel Margin="20,16,20,16">
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Content="完成"
                                    Style="{StaticResource TintButton}"
                                    FontSize="13" FontWeight="SemiBold"
                                    Command="{Binding CloseClipboardCommand}" />
                            <TextBlock Text="剪切板" FontSize="20" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <DockPanel DockPanel.Dock="Top" Margin="0,4,0,8">
                            <Button DockPanel.Dock="Right" Content="清空"
                                    Style="{StaticResource TintButton}"
                                    FontSize="11.5" Padding="7,3"
                                    Foreground="{StaticResource DangerBrush}"
                                    Command="{Binding ClearClipboardCommand}" />
                            <TextBlock Text="{Binding ClipboardHistory.Count, StringFormat='最近 {0} 条 · 点击即可重新复制'}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextHintBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <Grid MinHeight="220">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding ClipboardHistory.Count, Converter={StaticResource CountToVis}, ConverterParameter=Invert}">
                                <Border Width="68" Height="68" CornerRadius="34"
                                        Background="{StaticResource PrimaryLightBrush}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE77F;" FontFamily="{StaticResource IconFont}"
                                               FontSize="26"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="暂无剪切板记录" FontSize="15" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,12,0,0" />
                                <TextBlock Text="复制任意文字后会自动记录"
                                           FontSize="12" Foreground="{StaticResource TextHintBrush}"
                                           HorizontalAlignment="Center" Margin="0,5,0,0" />
                            </StackPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding ClipboardHistory.Count, Converter={StaticResource CountToVis}}">
                                <ItemsControl ItemsSource="{Binding ClipboardHistory}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ClipboardEntry}">
                                            <Border Cursor="Hand"
                                                    BorderBrush="{StaticResource DividerBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    ToolTip="点击复制"
                                                    MouseLeftButtonUp="ClipboardItem_Click">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background"
                                                                        Value="{StaticResource BgHoverBrush}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid Margin="2,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Preview}"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="58"
                                                               TextTrimming="CharacterEllipsis"
                                                               FontSize="13"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               Margin="0,0,12,0" />
                                                    <StackPanel Grid.Column="1"
                                                                VerticalAlignment="Top"
                                                                Margin="0,1,0,0">
                                                        <TextBlock Text="{Binding TimeText}"
                                                                   FontSize="10.5"
                                                                   Foreground="{StaticResource TextHintBrush}"
                                                                   HorizontalAlignment="Right" />
                                                        <TextBlock Text="复制" FontSize="10.5"
                                                                   Foreground="{StaticResource PrimaryBrush}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="0,6,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ════════════════════════════════════════════════════════════
                 IMPORT PROGRESS OVERLAY
                 ════════════════════════════════════════════════════════════ -->
            <Border Grid.RowSpan="5" Panel.ZIndex="20" Background="#4D000000"
                    Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}">
                <Border Background="{StaticResource BgCardBrush}" CornerRadius="16"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Padding="24,20" Width="320"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="正在导入" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ImportStatus}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,6,0,16" TextWrapping="Wrap" />
                        <ProgressBar IsIndeterminate="True" Height="4"
                                     Background="{StaticResource BgInputBrush}"
                                     Foreground="{StaticResource PrimaryBrush}"
                                     BorderThickness="0" />
                    </StackPanel>
                </Border>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 TOAST
                 ════════════════════════════════════════════════════════════ -->
            <Border Grid.RowSpan="5"
                    Visibility="{Binding ShowToastFlag, Converter={StaticResource BoolToVis}}"
                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="0,0,0,64" IsHitTestVisible="False">
                <Border Background="#E61C1C1E" CornerRadius="18" Padding="18,9">
                    <TextBlock Text="{Binding ToastMessage}" FontSize="12.5"
                               Foreground="White" FontWeight="Medium" />
                </Border>
            </Border>

        </Grid>
    </Border>
</Window>
